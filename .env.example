# Google Cloud Vertex AI, Speech-to-Text V2 (Chirp 3), & Cloud Storage Configuration (100% ADC)
# Run `gcloud auth application-default login` and `./setup.sh --project your-gcp-project-id` to auto-provision.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1
STT_LOCATION=us
TRANSCRIBE_MODEL=chirp_3
SUMMARY_MODEL=gemini-3.8-flash
SUBTITLE_CRAFT_BUCKET=subtitle-craft-your-gcp-project-id
GCS_BUCKET=subtitle-craft-your-gcp-project-id
